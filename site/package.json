{
  "name": "parallax-site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "capture": "node capture/run.mjs",
    "sync-themes": "node scripts/sync-themes.mjs",
    "predev": "npm run sync-themes && npm run sync-credits && npm run sync-changelog && npm run gen-api-docs",
    "dev": "next dev",
    "prebuild": "npm run sync-themes && npm run sync-credits && npm run sync-changelog && npm run gen-api-docs",
    "build": "next build",
    "postbuild": "node scripts/check-coverage.mjs",
    "check": "node scripts/check-coverage.mjs",
    "check:quick": "npm run gen-api-docs && node scripts/check-coverage.mjs --quick",
    "postinstall": "fumadocs-mdx",
    "sync-credits": "node scripts/sync-credits.mjs",
    "sync-changelog": "node scripts/sync-changelog.mjs",
    "gen-openapi": "python3 scripts/gen-openapi.py",
    "gen-api-docs": "node scripts/generate-api-docs.mjs"
  },
  "dependencies": {
    "fumadocs-core": "^16.18.0",
    "fumadocs-mdx": "^15.5.0",
    "fumadocs-openapi": "^12.6.0",
    "fumadocs-ui": "^16.18.0",
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.0"
  }
}
