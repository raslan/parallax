# Refuse to commit any staged path that .gitignore says should be excluded
# (i.e. it was only added via `git add -f`). This repo has deliberately
# gitignored paths (CLAUDE.md, docs/) that must never be force-added.
staged_added=$(git diff --cached --name-only --diff-filter=A)
ignored_staged=""
if [ -n "$staged_added" ]; then
  ignored_staged=$(printf '%s\n' "$staged_added" | git check-ignore --no-index --stdin || true)
fi
if [ -n "$ignored_staged" ]; then
  echo "error: refusing to commit force-added gitignored file(s):"
  echo "$ignored_staged" | sed 's/^/  /'
  echo "If this is intentional, add an explicit negation (!path) to .gitignore first."
  exit 1
fi

npx lint-staged

# Dead-code gate: run knip when frontend TS/TSX is staged (project-wide, ~1s).
if git diff --cached --name-only | grep -q '^frontend/src/.*\.tsx\?$'; then
  (cd frontend && npx knip) || {
    echo "error: knip found unused files/exports/deps — fix or adjust frontend/knip.json"
    exit 1
  }
fi
